# Copy to config.ini and fill in. config.ini is gitignored: it holds a bot
# token, which is the bot.

[telegram]
# my.telegram.org -> API development tools. Telethon needs these even for a
# bot; they identify the client, not the account.
api_id =
api_hash =

# @BotFather -> /newbot.
#
# For a CHANNEL: Manage channel -> Administrators -> Add admin -> your bot,
# and leave "Post Messages" on. A channel only accepts posts from admins, so
# a bot that is merely subscribed cannot publish - it will say so in the log
# rather than retrying in silence.
#
# For a GROUP: adding the bot is enough, unless the group restricts posting.
bot_token =

# A channel or supergroup looks like -1001234567890, a basic group like
# -987654321; all three work. Forward any message from it to @JsonDumpBot to
# read the id, or open the channel in web.telegram.org and take the number
# from the url, prefixed with -100.
chat_id =

[watch]
# What refresh.sh publishes. Must match REFRESH_OUT, and be mounted in.
path = /var/lib/xray/working.txt
# Seconds between checks. Content-hashed, so an unchanged republish is quiet.
interval = 30

# Both live on the named volume, so a container restart neither re-authenticates
# nor re-sends the list it already sent.
state = /var/lib/tgpush/state
session = /var/lib/tgpush/tgpush

# Only nodes that were not in the previous publish are sent. The first run
# has nothing to compare against, so it sends the whole list once.
#
# Bold header above each message. {n} how many are new, {total} how many are
# working in all, {when} human time, {stamp} a compact UTC timestamp. The new
# nodes follow in a fenced block, split across several messages when they pass
# Telegram's 4096-character limit - about seventeen nodes - with a (1/3)
# counter appended to this line.
caption = {n} new node(s) - {total} working - {when}
