# Generated config: node credentials, and the wireguard server key.
conf/
# Subscription files and whatever they were fetched into. Same credentials,
# one URI per node, and a sub link is usually an account.
subs/
__pycache__/
alive-probe.log
# The subscription list: the urls are usually accounts.
subscriptions.txt
# What refresh.sh publishes: every surviving node's uuid or password.
working.txt
# The bot's token, and its session.
telegram/config.ini
telegram/*.session
