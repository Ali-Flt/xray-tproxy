[Unit]
Description=Refresh the xray pool on a schedule

[Timer]
# OnUnitInactiveSec, not OnCalendar: the interval is measured from when the
# last cycle FINISHED. A cycle waits for the pool to go quiet and can run for
# half an hour, so a fixed schedule would queue runs on top of each other -
# the script's flock would then turn every second one into a no-op.
OnBootSec=5min
OnUnitInactiveSec=30min
# Free public pools are shared; do not have every installation of this hit the
# same subscription URLs on the same minute.
RandomizedDelaySec=3min

# Change the interval with a drop-in rather than by editing this file, so it
# survives install.sh --force-units:
#
#   systemctl edit xray-refresh.timer
#     [Timer]
#     OnUnitInactiveSec=
#     OnUnitInactiveSec=15min
#
# ⚠ The empty assignment is not decoration. Monotonic timer settings ACCUMULATE
#   across drop-ins: without it you get two triggers, the old one and the new,
#   and the timer fires on whichever comes first.
#
# Persistent= is deliberately absent. It only affects OnCalendar= timers - it
# catches up a wall-clock run missed while the machine was off - and does
# nothing at all beside a monotonic one, so it was a no-op claiming to be a
# setting. Switch to OnCalendar= and it becomes worth adding.

[Install]
WantedBy=timers.target
